{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev -w @taskflow/api\" \"npm run dev -w @taskflow/web\"",
    "build": "npm run typecheck && npm run build -w @taskflow/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && npm run typecheck -w @taskflow/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx apps/api/src/seed.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "setup": "node scripts/setup.mjs",
    "setup:email": "node scripts/setup-email.mjs",
    "mail:check": "node --env-file-if-exists=.env --import tsx scripts/check-email.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-db.mjs",
    "db:restore-check": "node scripts/restore-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "smtp-server": "^3.19.22",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
