{
  "name": "TaskFlow - Daily due task email (07:30 Bangkok)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 30
            }
          ]
        }
      },
      "id": "20c29ce4-7cdb-4d1a-a3a6-96daa9785cfa",
      "name": "Daily 07:30 Bangkok",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        512
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3000/api/integrations/due-tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "c24581a5-9f16-4d81-b3cc-362b616d27ee",
      "name": "Get due tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        512
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wFDVlCKG5bKlnOXR",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-due-tasks",
              "leftValue": "={{ $json.tasks.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f8b1ffbf-6169-4df4-ac4c-e5f73a214e50",
      "name": "Has due tasks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        512
      ]
    },
    {
      "parameters": {
        "fromEmail": "purinut.satronkit@gmail.com",
        "toEmail": "={{ $json.user.email }}",
        "subject": "={{ 'TaskFlow: ' + $json.tasks.length + ' งานที่ต้องทำ — ' + $json.date }}",
        "emailFormat": "text",
        "text": "={{ 'สวัสดี ' + $json.user.name + '\\n\\nงานที่ครบกำหนดหรือเลยกำหนด ณ วันที่ ' + $json.date + '\\n\\n' + $json.tasks.map((task, index) => (index + 1) + '. ' + task.title + '\\n   กำหนดส่ง: ' + task.due_date + ' | ความสำคัญ: ' + task.priority + ' | สถานะ: ' + task.status).join('\\n\\n') + '\\n\\nเปิด TaskFlow เพื่ออัปเดตสถานะงาน\\nhttp://localhost:5173\\n\\nอีเมลนี้เป็นการเตือนรายวันจาก workflow ของคุณ' }}",
        "options": {
          "appendAttribution": false,
          "allowUnauthorizedCerts": false
        }
      },
      "id": "5280aee9-261f-4d31-bb34-d6151af49ba2",
      "name": "Send task summary",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        432
      ],
      "retryOnFail": false,
      "webhookId": "925271e1-b83f-4d71-90d4-1ebcba5940be",
      "credentials": {
        "smtp": {
          "id": "XSZwlkpUwqr9xEtV",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/integrations/reminders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task_ids: $('Get due tasks').first().json.tasks.map(task => task.id), date: $('Get due tasks').first().json.date, channel: 'email' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "49d6194e-c795-423b-aaca-2cb4d3421b25",
      "name": "Record sent reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        432
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "wFDVlCKG5bKlnOXR",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "content": "## ตั้งค่าก่อนเปิดใช้งาน\n1. เลือก Header Auth credential ใน HTTP Request ทั้งสอง node: Name = x-api-key, Value = API key ของผู้ใช้ TaskFlow\n2. เลือก SMTP credential และเปลี่ยน From Email เป็นที่อยู่จริง\n3. n8n บนเครื่อง: ใช้ localhost | n8n ใน Docker: เปลี่ยน URL ทั้งสองเป็น host.docker.internal และตั้ง API HOST=0.0.0.0 เฉพาะเมื่อจำเป็น\n4. Workflow settings: Asia/Bangkok (ตั้งไว้แล้ว)\n5. ทดสอบก่อน Publish/Activate; การทดสอบเต็ม flow จะส่งอีเมลจริง\n\nAPI key/SMTP secret ไม่อยู่ในไฟล์นี้\nไม่มี task → ไม่ส่งเมล\nSMTP fail → ไม่บันทึก reminder\nSMTP accepted ไม่ได้ยืนยันว่าเข้ากล่องผู้รับ\nถ้าส่งสำเร็จแต่บันทึกล้มเหลว อาจส่งซ้ำในการรันถัดไป",
        "height": 430,
        "width": 620,
        "color": 5
      },
      "id": "51d4bbe3-b653-4b9c-baa8-ee12d669273e",
      "name": "Setup and limitations",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        0
      ]
    }
  ],
