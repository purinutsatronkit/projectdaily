# Copy to .env and set a random JWT_SECRET (at least 32 characters).
JWT_SECRET=
DATABASE_PATH=./data/taskflow.sqlite
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# For npm start after build use APP_ORIGIN=http://localhost:3000
# Production needs HTTPS, NODE_ENV=production, and the real APP_ORIGIN.

# Forgot password: Gmail SMTP. Use a Google App Password, never your normal password.
# See docs/password-reset-gmail.md. Run npm run setup:email to add missing keys to .env.
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional sender address/name; defaults to SMTP_USER and TaskFlow.
SMTP_FROM=
SMTP_FROM_NAME=TaskFlow
